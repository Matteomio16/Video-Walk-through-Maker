<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Vwm.App.ViewModels"
        xmlns:ctrl="using:Vwm.App.Controls"
        x:Class="Vwm.App.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Video Walk-through Maker"
        Width="1180" Height="780" MinWidth="980" MinHeight="660"
        WindowStartupLocation="CenterScreen">

  <Grid Margin="26,20,26,16" RowDefinitions="Auto,*,Auto">

    <!-- ============================== header + stepper ============================== -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,18">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14">
        <Border Classes="logo" VerticalAlignment="Center">
          <TextBlock Text="&#9658;" />
        </Border>
        <StackPanel Spacing="2" VerticalAlignment="Center">
          <TextBlock Classes="h1" Text="Video Walk-through Maker" />
          <TextBlock Classes="faint" Text="Narrated walkthrough videos — everything stays on this computer" />
        </StackPanel>
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Border Classes="stepDot active"><TextBlock Text="1" /></Border>
        <TextBlock Classes="stepLabel active" Text="Files" />
        <Rectangle Classes="stepLine" />
        <Border Classes="stepDot" Classes.active="{Binding IsReviewReached}"><TextBlock Text="2" /></Border>
        <TextBlock Classes="stepLabel" Classes.active="{Binding IsReviewReached}" Text="Review" />
        <Rectangle Classes="stepLine" />
        <Border Classes="stepDot" Classes.active="{Binding IsGenerateReached}"><TextBlock Text="3" /></Border>
        <TextBlock Classes="stepLabel" Classes.active="{Binding IsGenerateReached}" Text="Create" />
      </StackPanel>
    </Grid>

    <!-- ============================== 1. INPUT ============================== -->
    <ScrollViewer Grid.Row="1" IsVisible="{Binding IsInputPage}" VerticalScrollBarVisibility="Auto">
      <Border Classes="card" MaxWidth="800" Padding="34,30" VerticalAlignment="Top"
              HorizontalAlignment="Center">
        <StackPanel Spacing="16">
          <StackPanel Spacing="3">
            <TextBlock Classes="h2" Text="Choose your recording and script" />
            <TextBlock Classes="hint" Text="Drop files anywhere in this window, or browse. Number your script steps (1., 2., …) or separate them with blank lines." />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Classes="hint" Text="Screen recording" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Grid.Column="0" Watermark="Video file (.mp4, .mkv, .mov…)"
                       Text="{Binding VideoPath}" />
              <Button Grid.Column="1" Classes="secondary" Margin="8,0,0,0" Content="Browse…" Click="OnBrowseVideo" />
            </Grid>
          </StackPanel>

          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Classes="hint" Text="Narration script" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="secondary small" Content="Load from file…" Click="OnBrowseScript" />
            </Grid>
            <TextBox Height="190" AcceptsReturn="True" TextWrapping="Wrap"
                     Watermark="1. Open the dashboard…&#10;2. Click the export tab…"
                     Text="{Binding ScriptText}" />
          </StackPanel>

          <Grid ColumnDefinitions="Auto,280,24,Auto">
            <TextBlock Grid.Column="0" Classes="hint" Text="Voice" VerticalAlignment="Center" Margin="0,0,10,0" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Voices}" SelectedItem="{Binding SelectedVoice}"
                      HorizontalAlignment="Stretch" />
            <CheckBox Grid.Column="3" Content="Keep original audio (quiet, in background)"
                      IsChecked="{Binding KeepOriginalAudio}" />
          </Grid>

          <Grid ColumnDefinitions="Auto,150,20,Auto,120,20,Auto,110">
            <TextBlock Grid.Column="0" Classes="hint" Text="Subtitles" VerticalAlignment="Center" Margin="0,0,10,0" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding SubtitleFonts}" SelectedItem="{Binding SelectedSubtitleFont}"
                      HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="14" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Column="3" Classes="hint" Text="Size" VerticalAlignment="Center" Margin="0,0,10,0" />
            <ComboBox Grid.Column="4" ItemsSource="{Binding SubtitleSizes}" SelectedItem="{Binding SelectedSubtitleSize}"
                      HorizontalAlignment="Stretch" />
            <TextBlock Grid.Column="6" Classes="hint" Text="Position" VerticalAlignment="Center" Margin="0,0,10,0" />
            <ComboBox Grid.Column="7" ItemsSource="{Binding SubtitlePositions}" SelectedItem="{Binding SelectedSubtitlePosition}"
                      HorizontalAlignment="Stretch" />
          </Grid>

          <Grid ColumnDefinitions="Auto,180">
            <TextBlock Grid.Column="0" Classes="hint" Text="Subtitle background" VerticalAlignment="Center" Margin="0,0,10,0" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding SubtitleBackgrounds}" SelectedItem="{Binding SelectedSubtitleBackground}"
                      HorizontalAlignment="Stretch" />
          </Grid>

          <StackPanel Spacing="6">
            <TextBlock Classes="hint" Text="Output" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Grid.Column="0" Watermark="Leave empty for &lt;video&gt;_narrated.mp4"
                       Text="{Binding OutputPath}" />
              <Button Grid.Column="1" Classes="secondary" Margin="8,0,0,0" Content="Save as…" Click="OnBrowseOutput" />
            </Grid>
          </StackPanel>

          <Button Classes="primary" HorizontalAlignment="Right" Margin="0,6,0,0"
                  Content="Analyze video  →"
                  Command="{Binding AnalyzeCommand}" IsEnabled="{Binding !IsBusy}" />
        </StackPanel>
      </Border>
    </ScrollViewer>

    <!-- ============================== 2. REVIEW ============================== -->
    <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto" IsVisible="{Binding IsReviewPage}">
      <StackPanel Grid.Row="0" Spacing="2" Margin="2,0,0,10">
        <TextBlock Classes="h2" Text="Check that each step lines up with the right part of the video" />
        <TextBlock Classes="hint" Text="Edit the step texts, listen to the voice, and preview each step's clip. Nudge a boundary slider if a guess is off." />
      </StackPanel>

      <Grid Grid.Row="1" ColumnDefinitions="*,16,400">
        <Border Grid.Column="0" Classes="card" Padding="6">
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Steps}" Margin="8">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:StepItem">
                  <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1"
                          Padding="6,10">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Border Grid.Column="0" Classes="stepBadge" Margin="0,4,12,0">
                        <TextBlock Text="{Binding Header}" />
                      </Border>
                      <TextBox Grid.Column="1" Text="{Binding Text}" AcceptsReturn="True" TextWrapping="Wrap" />
                      <StackPanel Grid.Column="2" Margin="10,0,0,0" Spacing="6" VerticalAlignment="Top">
                        <Button Classes="secondary small" MinWidth="110" HorizontalContentAlignment="Center"
                                Content="▶  Voice"
                                IsVisible="{Binding !IsPlaying}"
                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).PreviewVoiceCommand}"
                                CommandParameter="{Binding}" />
                        <Button Classes="secondary small" MinWidth="110" HorizontalContentAlignment="Center"
                                Content="■  Stop"
                                IsVisible="{Binding IsPlaying}"
                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).PreviewVoiceCommand}"
                                CommandParameter="{Binding}" />
                        <Button Classes="secondary small" MinWidth="110" HorizontalContentAlignment="Center"
                                Content="▶  Preview"
                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).PreviewClipCommand}"
                                CommandParameter="{Binding}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>

        <!-- in-app preview player -->
        <Border Grid.Column="2" Classes="card" Padding="14">
          <Panel>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                        IsVisible="{Binding !IsClipPreviewOpen}">
              <TextBlock Text="▶" FontSize="34" Foreground="{StaticResource TextFaintBrush}"
                         HorizontalAlignment="Center" />
              <TextBlock Classes="hint" Text="Press “Preview” on a step to watch it here,&#10;with its narration." TextAlignment="Center" />
            </StackPanel>
            <ctrl:ClipPlayerView x:Name="ClipPlayer" IsVisible="{Binding IsClipPreviewOpen}" />
          </Panel>
        </Border>
      </Grid>

      <Border Grid.Row="2" Classes="card" Padding="16,12" Margin="0,12,0,0">
        <Grid RowDefinitions="Auto,Auto,Auto">
          <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                        Margin="0,0,0,6">
            <ItemsControl ItemsSource="{Binding Thumbnails}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ThumbItem">
                  <StackPanel Margin="0,0,4,0">
                    <Border CornerRadius="4" ClipToBounds="True">
                      <Image Source="{Binding Image}" Height="60" />
                    </Border>
                    <TextBlock Classes="faint" Text="{Binding TimeLabel}" HorizontalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <ItemsControl Grid.Row="1" ItemsSource="{Binding Boundaries}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:BoundaryItem">
                <Grid ColumnDefinitions="110,*,64">
                  <TextBlock Grid.Column="0" Classes="hint" Text="{Binding Label}" VerticalAlignment="Center" />
                  <Slider Grid.Column="1" Minimum="0" Maximum="{Binding Max}" Value="{Binding TimeSeconds}" />
                  <TextBlock Grid.Column="2" Classes="hint" Text="{Binding TimeLabel}"
                             VerticalAlignment="Center" TextAlignment="Right" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0">
            <Button Grid.Column="0" Classes="secondary" Content="←  Back"
                    Command="{Binding BackToInputCommand}" />
            <Button Grid.Column="2" Classes="primary" Content="Create narrated video  →"
                    Command="{Binding GenerateCommand}" IsEnabled="{Binding !IsBusy}" />
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <!-- ============================== 3. GENERATE ============================== -->
    <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto" IsVisible="{Binding IsGeneratePage}"
          MaxWidth="820" HorizontalAlignment="Stretch">
      <StackPanel Grid.Row="0" Spacing="2" Margin="2,0,0,10">
        <TextBlock Classes="h2" Text="Creating your video" />
        <TextBlock Classes="hint" Text="This can take a few minutes — the voiceover is synthesized and the video re-rendered on this computer." />
      </StackPanel>

      <Border Grid.Row="1" Classes="card" Padding="16">
        <ScrollViewer x:Name="LogScroll">
          <ItemsControl ItemsSource="{Binding Log}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding}" Classes="hint" Margin="0,1" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>

      <StackPanel Grid.Row="2" Margin="0,12,0,0" Spacing="10">
        <Border Background="#E5F5EC" BorderBrush="#BCE3CD" BorderThickness="1" CornerRadius="8"
                Padding="14,10" IsVisible="{Binding IsDone}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="✓" FontSize="16" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
            <StackPanel Spacing="1">
              <TextBlock FontWeight="SemiBold" Text="Your narrated video is ready." />
              <TextBlock Classes="faint" Text="{Binding FinalOutputPath}" />
            </StackPanel>
          </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="secondary" Content="Cancel" Command="{Binding CancelGenerateCommand}"
                  IsVisible="{Binding IsBusy}" />
          <Button Classes="primary" Content="Open output folder"
                  Command="{Binding OpenOutputFolderCommand}" IsVisible="{Binding IsDone}" />
          <Button Classes="secondary" Content="Make another video" Command="{Binding StartOverCommand}"
                  IsEnabled="{Binding !IsBusy}" />
        </StackPanel>
      </StackPanel>
    </Grid>

    <!-- ============================== footer: busy + errors ============================== -->
    <StackPanel Grid.Row="2" Margin="0,10,0,0" Spacing="6">
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
      <TextBlock Classes="error" Text="{Binding ErrorMessage}"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
  </Grid>
</Window>
