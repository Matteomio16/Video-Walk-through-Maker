<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Vwm.App.Controls.BlurCanvas">

  <Panel x:Name="Root" Background="{StaticResource PlayerBackgroundBrush}" ClipToBounds="True">
    <Image x:Name="FrameImage" Stretch="Uniform" />

    <!-- Pointer surface: the box, its handles, and empty frame area you can drag on to
         draw a new rectangle. Transparent (not null) so it receives pointer events. -->
    <Canvas x:Name="Overlay" Background="Transparent">
      <Border x:Name="Box" IsVisible="False"
              Background="#8C9AA5B4" BorderBrush="#F0FFFFFF" BorderThickness="2" CornerRadius="2" />

      <Rectangle x:Name="HandleNW" Classes="handle" IsVisible="False" />
      <Rectangle x:Name="HandleN"  Classes="handle" IsVisible="False" />
      <Rectangle x:Name="HandleNE" Classes="handle" IsVisible="False" />
      <Rectangle x:Name="HandleW"  Classes="handle" IsVisible="False" />
      <Rectangle x:Name="HandleE"  Classes="handle" IsVisible="False" />
      <Rectangle x:Name="HandleSW" Classes="handle" IsVisible="False" />
      <Rectangle x:Name="HandleS"  Classes="handle" IsVisible="False" />
      <Rectangle x:Name="HandleSE" Classes="handle" IsVisible="False" />
    </Canvas>

    <TextBlock x:Name="EmptyHint" IsVisible="False"
               Foreground="White" Opacity="0.75" FontSize="13" TextAlignment="Center"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               Text="Add an area, then drag a box over what should be hidden." />
  </Panel>

  <UserControl.Styles>
    <Style Selector="Rectangle.handle">
      <Setter Property="Width" Value="11" />
      <Setter Property="Height" Value="11" />
      <Setter Property="Fill" Value="White" />
      <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
      <Setter Property="StrokeThickness" Value="2" />
    </Style>
  </UserControl.Styles>
</UserControl>
